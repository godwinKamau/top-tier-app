# Resend API key — the sendEmail route returns a JSON 500 without it.
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Absolute origin used for images in emails. Email clients cannot resolve a
# relative /logo.png, so this must be a publicly reachable URL.
NEXT_PUBLIC_SITE_URL=https://toptierscholarsystems.com
