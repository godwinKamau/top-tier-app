# Resend API key — the sendEmail route returns a JSON 500 without it.
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Absolute origin used for images in emails. Email clients cannot resolve a
# relative /logo.png, so this must be a publicly reachable URL.
NEXT_PUBLIC_SITE_URL=https://toptierscholarsystems.com

# Recommended for most uses
DATABASE_URL=

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

# Gate for the /berfday applications dashboard. Both are required — with either
# missing the dashboard refuses to render rather than falling open.
# DASHBOARD_SESSION_SECRET signs the session cookie; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing the access code invalidates every existing session.
DASHBOARD_ACCESS_CODE=
DASHBOARD_SESSION_SECRET=
